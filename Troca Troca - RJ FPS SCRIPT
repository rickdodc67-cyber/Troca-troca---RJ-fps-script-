local OG={s={},li={},terr=false}
local mOn=true

local function stL()
    if OG.li.s then return end
    OG.li={s=true,gs=L.GlobalShadows,br=L.Brightness,ed=L.EnvironmentDiffuseScale,es=L.EnvironmentSpecularScale}
end
local function rsL()
    if not OG.li.s then return end
    for k,v in pairs(OG.li) do if k~="s" then pcall(function() L[k]=v end) end end
end

local function mkC(chk)
    return function(v)
        if v then
            for _,d in ipairs(W:GetDescendants()) do
                if chk(d) then
                    local r={}
                    if d.Enabled~=nil then r.E=d.Enabled; d.Enabled=false end
                    if (d:IsA("Decal") or d:IsA("Texture")) and d.Transparency~=nil then r.T=d.Transparency; d.Transparency=1 end
                    if d:IsA("BasePart") and d.Reflectance>0 then r.R=d.Reflectance; d.Reflectance=0 end
                    if next(r) then OG.s[d]=r end
                end
            end
        else
            for i,r in pairs(OG.s) do
                if i and i.Parent then
                    pcall(function()
                        if r.E~=nil then i.Enabled=r.E end
                        if r.T~=nil then i.Transparency=r.T end
                        if r.R~=nil then i.Reflectance=r.R end
                    end)
                end
            end
            for k in pairs(OG.s) do OG.s[k]=nil end
        end
    end
end

local pAll=mkC(function(d) return d:IsA("ParticleEmitter") end)
local lAll=mkC(function(d) return d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") end)
local eAll=mkC(function(d) return d:IsA("Beam") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") end)
local dAll=mkC(function(d) return d:IsA("Decal") or d:IsA("Texture") end)
local rAll=mkC(function(d) return d:IsA("BasePart") and d.Reflectance>0 end)

local function pDist(v)
    if v then
        local cam=W.CurrentCamera; if not cam then return end
        local cp=cam.CFrame.Position
        for _,d in ipairs(W:GetDescendants()) do
            if d:IsA("ParticleEmitter") and d.Parent and d.Parent:IsA("BasePart") then
                if (d.Parent.Position-cp).Magnitude>150 then
                    OG.s[d]=OG.s[d] or {}; OG.s[d].E=d.Enabled; d.Enabled=false
                end
            end
        end
    end
end

local pRateStore={}
local function pRate(v)
    if v then
        for _,d in ipairs(W:GetDescendants()) do
            if d:IsA("ParticleEmitter") then pRateStore[d]=d.Rate; d.Rate=d.Rate*0.3 end
        end
    else
        for inst,orig in pairs(pRateStore) do
            if inst and inst.Parent then pcall(function() inst.Rate=orig end) end
        end
        pRateStore={}
    end
end

local function shT(v) if v then stL(); L.GlobalShadows=false elseif OG.li.gs~=nil then L.GlobalShadows=OG.li.gs end end
local function loT(v)
    if v then stL(); L.EnvironmentDiffuseScale=0; L.EnvironmentSpecularScale=0
    else if OG.li.ed~=nil then L.EnvironmentDiffuseScale=OG.li.ed end; if OG.li.es~=nil then L.EnvironmentSpecularScale=OG.li.es end end
end
local function teT(v)
    pcall(function()
        if v then
            OG.terr=W.Terrain.Decoration; W.Terrain.Decoration=false
            W.Terrain.WaterWaveSize=0; W.Terrain.WaterReflectance=0
        else W.Terrain.Decoration=OG.terr end
    end)
end

function mApply(s)
    mOn=s
    if s then
        stL(); pAll(true); lAll(true); eAll(true); dAll(true)
        L.GlobalShadows=false; L.EnvironmentDiffuseScale=0; L.EnvironmentSpecularScale=0
        pcall(function() W.Terrain.Decoration=false end)
        nt("MASTER BOOST ON",C.on)
    else
        for i,r in pairs(OG.s) do
            if i and i.Parent then
                pcall(function()
                    if r.E~=nil then i.Enabled=r.E end
                    if r.T~=nil then i.Transparency=r.T end
                    if r.R~=nil then i.Reflectance=r.R end
                end)
            end
        end
        for k in pairs(OG.s) do OG.s[k]=nil end
        rsL(); pcall(function() W.Terrain.Decoration=true end)
        nt("Gráfico restaurado",C.off)
    end
end

-- Gráfico Mínimo
local LQ={on=true,originalQuality=nil,meshes={},materials={},decals={},originalReflectance={},descConn=nil}
local UserSettingsService=nil
pcall(function() UserSettingsService=game:GetService("UserSettings") end)

local function applyLowQuality(inst)
    if not LQ.on then return end
    pcall(function()
        if inst:IsA("MeshPart") then
            if LQ.meshes[inst]==nil then LQ.meshes[inst]=inst.RenderFidelity end
            inst.RenderFidelity=Enum.RenderFidelity.Performance
        end
        if inst:IsA("BasePart") then
            if inst.Material~=Enum.Material.SmoothPlastic then
                if LQ.materials[inst]==nil then LQ.materials[inst]=inst.Material end
                inst.Material=Enum.Material.SmoothPlastic
            end
            if inst.Reflectance>0 then
                if LQ.originalReflectance[inst]==nil then LQ.originalReflectance[inst]=inst.Reflectance end
                inst.Reflectance=0
            end
        end
        if inst:IsA("Decal") or inst:IsA("Texture") then
            if LQ.decals[inst]==nil then LQ.decals[inst]=inst.Transparency end
            inst.Transparency=1
        end
    end)
end

local function setLowQuality(v)
    LQ.on=v
    if v then
        pcall(function()
            if UserSettingsService then
                local s=UserSettingsService:GetService("UserGameSettings")
                LQ.originalQuality=s.SavedQualityLevel
                s.SavedQualityLevel=Enum.SavedQualitySetting.QualityLevel1
            end
        end)
        for _,d in ipairs(W:GetDescendants()) do applyLowQuality(d) end
        if LQ.descConn then LQ.descConn:Disconnect() end
        LQ.descConn=W.DescendantAdded:Connect(function(d) if LQ.on then applyLowQuality(d) end end)
        nt("Gráfico MÍNIMO ativado",C.on)
    else
        pcall(function()
            if LQ.originalQuality and UserSettingsService then
                local s=UserSettingsService:GetService("UserGameSettings")
                s.SavedQualityLevel=LQ.originalQuality
            end
        end)
        for part,mat in pairs(LQ.materials) do if part and part.Parent then pcall(function() part.Material=mat end) end end
        LQ.materials={}
        for mesh,fid in pairs(LQ.meshes) do if mesh and mesh.Parent then pcall(function() mesh.RenderFidelity=fid end) end end
        LQ.meshes={}
        for decal,t in pairs(LQ.decals) do if decal and decal.Parent then pcall(function() decal.Transparency=t end) end end
        LQ.decals={}
        for part,r in pairs(LQ.originalReflectance) do if part and part.Parent then pcall(function() part.Reflectance=r end) end end
        LQ.originalReflectance={}
        if LQ.descConn then pcall(function() LQ.descConn:Disconnect() end); LQ.descConn=nil end
        nt("Gráfico restaurado",C.off)
    end
end


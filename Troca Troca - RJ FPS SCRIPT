local PART_OPTIONS={
    {id="Torso",label="Torso",names={"HumanoidRootPart","Torso","UpperTorso"}},
    {id="Head",label="Head",names={"Head"}},
    {id="Peito",label="Peito",names={"UpperTorso","Torso","HumanoidRootPart"}},
    {id="Barriga",label="Barriga",names={"LowerTorso","Torso","HumanoidRootPart"}},
    {id="Braços",label="Braços",names={"LeftUpperArm","RightUpperArm","Left Arm","Right Arm","HumanoidRootPart"}},
    {id="Pernas",label="Pernas",names={"LeftUpperLeg","RightUpperLeg","Left Leg","Right Leg","HumanoidRootPart"}},
}

local AA={
    enabled=true,
    range=350,fov=40,strength=0.55,
    visibleOnly=true,ignoreNearby=true,nearbyDist=15,
    teamCheck=true,target=nil,lockPart="Torso",
    prediction=0.25,showFOV=false,
    spreadShot=false,spreadAngle=3,
}

local function isEnemyAA(plr)
    if plr==lp then return false end
    if not AA.teamCheck then return true end
    if plr.Team==nil or lp.Team==nil then return true end
    return plr.Team~=lp.Team
end

local function isVisibleAA(fromPos,toPos)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.IgnoreWater=true
    local excludeList={lp.Character,W.CurrentCamera}
    pcall(function()
        local myChar=lp.Character
        if myChar then
            local hum=myChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                local seat=hum.SeatPart
                local vehicle=seat:FindFirstAncestorOfClass("Model")
                table.insert(excludeList,vehicle or seat)
            end
        end
    end)
    params.FilterDescendantsInstances=excludeList
    local ray=W:Raycast(fromPos,toPos-fromPos,params)
    if not ray then return true end
    local hit=ray.Instance
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=lp and plr.Character and plr.Character:IsAncestorOf(hit) then return true end
    end
    if AA.ignoreNearby then
        if (ray.Position-fromPos).Magnitude < AA.nearbyDist then return true end
    end
    return false
end

local function getTargetPartAA(plr)
    local ch=plr.Character
    if not ch then return nil end
    for _,opt in ipairs(PART_OPTIONS) do
        if opt.id==AA.lockPart then
            for _,partName in ipairs(opt.names) do
                local p=ch:FindFirstChild(partName)
                if p then return p end
            end
            break
        end
    end
    return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
end

local function predictPosAA(part)
    if not part or not part.Parent then return nil end
    local vel=part.AssemblyLinearVelocity or Vector3.new(0,0,0)
    return part.Position + vel*AA.prediction
end

local function getFOVAA(targetPos)
    local cam=W.CurrentCamera
    if not cam then return 999 end
    local toTarget=(targetPos-cam.CFrame.Position).Unit
    local dot=cam.CFrame.LookVector:Dot(toTarget)
    return math.deg(math.acos(math.clamp(dot,-1,1)))
end

local function getBestTargetAA()
    local cam=W.CurrentCamera
    if not cam then return nil end
    local camPos=cam.CFrame.Position
    local best=nil
    local bestFOV=AA.fov
    for _,plr in ipairs(P:GetPlayers()) do
        if isEnemyAA(plr) then
            local ch=plr.Character
            local hum=ch and ch:FindFirstChildOfClass("Humanoid")
            if ch and hum and hum.Health>0 then
                local part=getTargetPartAA(plr)
                if part then
                    local pos=part.Position
                    local dist=(pos-camPos).Magnitude
                    if dist<=AA.range then
                        local fov=getFOVAA(pos)
                        if fov<=bestFOV then
                            if not AA.visibleOnly or isVisibleAA(camPos,pos) then
                                best={plr=plr,part=part,pos=pos,dist=dist,fov=fov}
                                bestFOV=fov
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local aaCircle=I("Frame",{Parent=sg,Size=UDim2.new(0,100,0,100),Position=UDim2.new(.5,-50,.5,-50),BackgroundTransparency=1,BorderSizePixel=0,Visible=false,ZIndex=2})
I("UIStroke",{Parent=aaCircle,Color=C.on,Thickness=2,Transparency=0.4})
cr(aaCircle,999)

local function aaStep()
    if AA.showFOV and AA.enabled then
        local cam=W.CurrentCamera
        if cam then
            local vp=cam.ViewportSize
            local radius=math.tan(math.rad(AA.fov/2))*vp.Y/2/math.tan(math.rad(35))
            radius=math.clamp(radius,20,1500)
            aaCircle.Size=UDim2.new(0,radius*2,0,radius*2)
            aaCircle.Position=UDim2.new(.5,-radius,.5,-radius)
        end
        aaCircle.Visible=true
    else aaCircle.Visible=false end

    if not AA.enabled then return end
    local best=getBestTargetAA()
    AA.target=best and best.plr or nil
    if not best or not best.part or not best.part.Parent then return end

    local cam=W.CurrentCamera
    if not cam then return end
    local camPos=cam.CFrame.Position
    local targetPos=predictPosAA(best.part) or best.part.Position
    if (targetPos-camPos).Magnitude<1 then return end

    if AA.spreadShot then
        local ang=math.rad(AA.spreadAngle)
        local rx=(math.random()-0.5)*ang
        local ry=(math.random()-0.5)*ang
        local cf=CFrame.Angles(rx,ry,0)
        targetPos=camPos+(cf*(targetPos-camPos))
    end

    local lookCFrame=CFrame.lookAt(camPos,targetPos)
    local proximity=1-(best.fov/AA.fov)
    local finalStrength=AA.strength*(0.4+proximity*0.6)
    cam.CFrame=cam.CFrame:Lerp(lookCFrame,finalStrength)
end

pcall(function() R:UnbindFromRenderStep("DeltaAimAssist") end)
R:BindToRenderStep("DeltaAimAssist",9998,aaStep)


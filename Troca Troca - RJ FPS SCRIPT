local hbState={on=false,multiplier=2,visible=false,boxes={}}

local function isEnemy(plr)
    if plr==lp then return false end
    if plr.Team==nil or lp.Team==nil then return true end
    return plr.Team~=lp.Team
end

local function makeHitbox(plr)
    local ch=plr.Character
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if hbState.boxes[plr] then return end
    local origSize=hrp.Size
    local origT=hrp.Transparency
    local origC=hrp.Color
    local origM=hrp.Material
    hrp.Size=origSize*Vector3.new(hbState.multiplier,hbState.multiplier,hbState.multiplier)
    hrp.CanQuery=true; hrp.CanTouch=true
    local boxSize=origSize*Vector3.new(hbState.multiplier+0.5,hbState.multiplier+0.5,hbState.multiplier+0.5)
    local box=I("Part",{Name="DeltaHitbox_"..plr.Name,Size=boxSize,Transparency=hbState.visible and 0.4 or 1,Color=Color3.fromRGB(255,40,40),Material=Enum.Material.Neon,CanCollide=false,CanQuery=true,CanTouch=true,Massless=true,Anchored=false,CastShadow=false,Parent=ch,CFrame=hrp.CFrame})
    box:SetAttribute("DeltaHitbox",true)
    local weld=I("WeldConstraint",{Part0=hrp,Part1=box,Parent=box})
    if hbState.visible then hrp.Transparency=0.4; hrp.Color=Color3.fromRGB(255,40,40); hrp.Material=Enum.Material.Neon end
    local diedConn=hum.Died:Connect(function() restoreHitbox(plr) end)
    local chConn=ch.AncestryChanged:Connect(function(_,parent) if not parent then restoreHitbox(plr) end end)
    hbState.boxes[plr]={part=box,hrp=hrp,hum=hum,origSize=origSize,origT=origT,origC=origC,origM=origM,diedConn=diedConn,chConn=chConn}
end

function restoreHitbox(plr)
    local d=hbState.boxes[plr]
    if not d then return end
    if d.diedConn then pcall(function() d.diedConn:Disconnect() end) end
    if d.chConn then pcall(function() d.chConn:Disconnect() end) end
    if d.part and d.part.Parent then pcall(function() d.part:Destroy() end) end
    if d.hrp and d.hrp.Parent then
        pcall(function()
            d.hrp.Size=d.origSize; d.hrp.Transparency=d.origT; d.hrp.Color=d.origC
            if d.origM then d.hrp.Material=d.origM end
        end)
    end
    hbState.boxes[plr]=nil
end

function clearAllHitboxes()
    for plr in pairs(hbState.boxes) do restoreHitbox(plr) end
    hbState.boxes={}
end

function setHitbox(v)
    hbState.on=v
    if v then
        for _,plr in ipairs(P:GetPlayers()) do
            if plr~=lp and isEnemy(plr) then makeHitbox(plr) end
        end
    else clearAllHitboxes() end
end

function setHitboxMultiplier(m)
    hbState.multiplier=m
    for plr,d in pairs(hbState.boxes) do
        if d.hrp and d.hrp.Parent and d.origSize then d.hrp.Size=d.origSize*Vector3.new(m,m,m) end
        if d.part and d.part.Parent and d.origSize then d.part.Size=d.origSize*Vector3.new(m+0.5,m+0.5,m+0.5) end
    end
end

function setHitboxVisible(v)
    hbState.visible=v
    for plr,d in pairs(hbState.boxes) do
        if d.part and d.part.Parent then d.part.Transparency=v and 0.4 or 1 end
        if d.hrp and d.hrp.Parent then
            if v then d.hrp.Transparency=0.4; d.hrp.Color=Color3.fromRGB(255,40,40); d.hrp.Material=Enum.Material.Neon
            else d.hrp.Transparency=d.origT; d.hrp.Color=d.origC; if d.origM then d.hrp.Material=d.origM end end
        end
    end
end


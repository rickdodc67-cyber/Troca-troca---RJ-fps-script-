local function startFly()
    local ch=lp.Character
    local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    flyBV=I("BodyVelocity",{Parent=hrp,MaxForce=Vector3.new(1e5,1e5,1e5),Velocity=Vector3.new(0,0,0)})
    flyBG=I("BodyGyro",{Parent=hrp,MaxTorque=Vector3.new(1e5,1e5,1e5),P=1000,D=50,CFrame=hrp.CFrame})
    flyConn=R.RenderStepped:Connect(function()
        if not flyOn then return end
        local cam=W.CurrentCamera
        if not cam then return end
        local hum=ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand=true end
        local move=Vector3.new(0,0,0)
        if U:IsKeyDown(Enum.KeyCode.W) then move=move+cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.S) then move=move-cam.CFrame.LookVector end
        if U:IsKeyDown(Enum.KeyCode.A) then move=move-cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.D) then move=move+cam.CFrame.RightVector end
        if U:IsKeyDown(Enum.KeyCode.Space) then move=move+Vector3.new(0,1,0) end
        if U:IsKeyDown(Enum.KeyCode.LeftControl) then move=move-Vector3.new(0,1,0) end
        if move.Magnitude>0 then move=move.Unit*flySpeed end
        if flyBV then flyBV.Velocity=move end
        if flyBG then flyBG.CFrame=cam.CFrame end
    end)
end
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV=nil end
    if flyBG then flyBG:Destroy(); flyBG=nil end
    if flyConn then flyConn:Disconnect(); flyConn=nil end

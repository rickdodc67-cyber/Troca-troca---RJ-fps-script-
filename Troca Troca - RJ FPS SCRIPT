    local tr=I("Frame",{Parent=r,Size=UDim2.new(1,0,0,6),Position=UDim2.new(0,0,0,26),BackgroundColor3=C.pn,BorderSizePixel=0}); cr(tr,3)
    local p0=(def-mn)/(mx-mn)
    local fl=I("Frame",{Parent=tr,Size=UDim2.new(p0,0,1,0),BackgroundColor3=C.ac,BorderSizePixel=0}); cr(fl,3)
    local kn=I("Frame",{Parent=tr,Size=UDim2.new(0,14,0,14),Position=UDim2.new(p0,-7,.5,-7),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=2}); cr(kn,7)
    local function st(v,c)
        v=math.clamp(v,mn,mx); if stp then v=math.floor(v/stp+.5)*stp end
        local p=(v-mn)/(mx-mn)
        fl.Size=UDim2.new(p,0,1,0); kn.Position=UDim2.new(p,-7,.5,-7)
        vl.Text=(v==math.floor(v)) and tostring(math.floor(v)) or string.format("%.1f",v)
        if c and cb then cb(v) end
    end
    local dg=false
    local function up(i) st(mn+math.clamp((i.Position.X-tr.AbsolutePosition.X)/tr.AbsoluteSize.X,0,1)*(mx-mn),true) end
    tr.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=true; up(i) end end)
    U.InputChanged:Connect(function(i) if dg and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then up(i) end end)
    U.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=false end end)
    st(def,false)
end


local function sld(parent,lbl,mn,mx,def,stp,cb)
    local r=I("Frame",{Parent=parent,Size=UDim2.new(1,0,0,44),BackgroundTransparency=1})
    I("TextLabel",{Parent=r,Size=UDim2.new(.65,0,0,16),BackgroundTransparency=1,Text=lbl,TextColor3=C.tx,Font=F,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left})

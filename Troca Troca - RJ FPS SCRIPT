local NR={enabled=true,strength=0.85,threshold=0.02,lastCFrame=nil,_conn=nil,shots=0}

local function startNoRecoil()
    NR._conn=R.RenderStepped:Connect(function()
        if not NR.enabled then return end
        local cam=W.CurrentCamera
        if not cam then return end
        local current=cam.CFrame
        if NR.lastCFrame then
            local rotDiff=(current.LookVector-NR.lastCFrame.LookVector).Magnitude
            local posDiff=(current.Position-NR.lastCFrame.Position).Magnitude
            if rotDiff>NR.threshold and posDiff<0.5 then
                NR.shots=NR.shots+1
                local restored=CFrame.new(current.Position,current.Position+NR.lastCFrame.LookVector)
                cam.CFrame=current:Lerp(restored,NR.strength)
            end
        end
        NR.lastCFrame=cam.CFrame
    end)
end

local function setNoRecoil(v)
    NR.enabled=v
    if v and not NR._conn then startNoRecoil(); nt("No Recoil ON",C.on)
    elseif not v and NR._conn then NR._conn:Disconnect(); NR._conn=nil; NR.lastCFrame=nil; nt("No Recoil OFF",C.off) end
end

-- ==================================================================
-- NO SPREAD (ATIVADO)
-- ==================================================================
local NS={enabled=true,strength=0.9,threshold=0.015,stabilizeTime=0.15,lastCFrame=nil,stableCFrame=nil,lastShotTime=0,_conn=nil,shots=0}

local function startNoSpread()
    NS._conn=R.RenderStepped:Connect(function()
        if not NS.enabled then return end
        local cam=W.CurrentCamera
        if not cam then return end
        local current=cam.CFrame
        local now=tick()
        if NS.lastCFrame then
            local rotDiff=(current.LookVector-NS.lastCFrame.LookVector).Magnitude
            local posDiff=(current.Position-NS.lastCFrame.Position).Magnitude
            if rotDiff>NS.threshold and posDiff<0.5 then
                NS.shots=NS.shots+1
                NS.lastShotTime=now
                if not NS.stableCFrame then NS.stableCFrame=NS.lastCFrame end
            end
        end
        if NS.stableCFrame and (now-NS.lastShotTime)<NS.stabilizeTime then
            local pos=current.Position
            local stableLook=NS.stableCFrame.LookVector
            local target=CFrame.new(pos,pos+stableLook)
            cam.CFrame=current:Lerp(target,NS.strength)
        elseif NS.stableCFrame and (now-NS.lastShotTime)>=NS.stabilizeTime then
            NS.stableCFrame=nil
        end
        NS.lastCFrame=cam.CFrame
    end)
end

local function setNoSpread(v)
    NS.enabled=v
    if v and not NS._conn then startNoSpread(); nt("No Spread ON",C.on)
    elseif not v and NS._conn then NS._conn:Disconnect(); NS._conn=nil; NS.lastCFrame=nil; NS.stableCFrame=nil; nt("No Spread OFF",C.off) end
end

